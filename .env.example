# 직구곰 환경변수 예시 — 복사해서 .env 로 쓰세요 (cp .env.example .env)
# .env 는 절대 깃에 커밋하지 마세요 (.gitignore 에 포함됨).
# 키를 채운 레이어만 자동으로 real 로 전환됩니다 (비우면 mock).

# ── 소싱: Amazon (Rainforest API, 유료) ──────────────────────
# https://rainforestapi.com  — 없으면 SampleSource(mock)
RAINFOREST_API_KEY=
AMAZON_DOMAIN=amazon.com

# ── 판매채널: 네이버 커머스 API (사업자등록 필요) ─────────────
# 판매자센터 → API 설정. 둘 다 있어야 real (하나만 있으면 시작 시 에러).
# real 사용 시: pip install bcrypt
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 에이전트 LLM / 번역 (선택) ───────────────────────────────
# 없으면 휴리스틱/템플릿 mock 으로 graceful degrade.
# real 사용 시: pip install anthropic
ANTHROPIC_API_KEY=
DEEPL_API_KEY=

# ── 운영 파라미터 ────────────────────────────────────────────
FX_RATE=1380                       # USD→KRW 환율(고정). 실시간 연동은 후속
SOURCING_CATEGORY=Best             # 소싱 대상 카테고리
SALES_CHANNELS=naver,coupang       # 동시등록 채널 (쿠팡은 현재 mock 고정)
MONITOR_INTERVAL_SECONDS=300       # 가격·재고 자동점검 주기(0=수동만)

# ── 저장소 ───────────────────────────────────────────────────
# 기본 SQLite 파일. PostgreSQL: postgresql+psycopg://user:pw@host/db
# DATABASE_URL=sqlite:///./jikgugom.db
